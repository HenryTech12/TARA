# Used by `docker compose` for ${VAR} substitution in docker-compose.yml —
# copy to .env (repo root) and fill in for `docker compose up --build`.
# This is separate from backend/.env.example, which is for running the app
# directly (uvicorn) without Docker.

# Required — no local Postgres container is bundled in docker-compose.yml,
# the backend connects straight to whatever's here. SQLAlchemy+psycopg
# scheme: postgresql+psycopg://user:pass@host:port/db?sslmode=require
POSTGRES_URL=

QOREID_CLIENT_ID=
QOREID_API_KEY=
QOREID_BASE_URL=https://api.qoreid.com/v1
