# Copy to .env and fill in real values for local dev.

# Postgres connection string used by SQLAlchemy (psycopg driver).
# Matches the default in docker-compose.yml — override only if you're
# pointing at a different instance.
POSTGRES_URL=postgresql+psycopg://tara:tara@localhost:5432/tara

# QoreID sandbox credentials. Leave QOREID_API_KEY blank to use the
# deterministic stub in app/services/qoreid_service.py — set it once
# sandbox credentials are issued to start hitting the real API (with
# automatic fallback to the stub if the live call fails).
QOREID_API_KEY=
QOREID_BASE_URL=https://api.qoreid.com/v1
